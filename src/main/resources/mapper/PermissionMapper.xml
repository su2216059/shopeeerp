<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.shopeeerp.mapper.PermissionMapper">

    <resultMap id="PermissionResultMap" type="com.example.shopeeerp.pojo.Permission">
        <id column="permission_id" property="permissionId" jdbcType="BIGINT"/>
        <result column="code" property="code" jdbcType="VARCHAR"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="selectAll" resultMap="PermissionResultMap">
        SELECT permission_id, code, name, description, created_at, updated_at
        FROM permissions
        ORDER BY permission_id ASC
    </select>

    <select id="selectCodesByRoleId" resultType="java.lang.String">
        SELECT p.code
        FROM permissions p
        INNER JOIN role_permissions rp ON rp.permission_id = p.permission_id
        WHERE rp.role_id = #{roleId}
        ORDER BY p.permission_id ASC
    </select>

</mapper>
